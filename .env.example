# All variables below are read by the Express server (server.ts) from a
# local .env file (or your shell) via services/vertexProxy.ts — both in
# local dev (`npm run dev`) and in production (`npm start`, e.g. on the
# Replit VM deployment / start.sh), since the same Express server backs
# both.

# ─── Gemini / Vertex AI (preferred backend) ──────────────────────────────
# Paste the entire Service Account JSON as a single-line string. The
# proxy will JSON.parse it on the server. NEVER commit the actual value.
GCP_SA_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}'
GCP_PROJECT_ID=your-gcp-project-id
# Optional. Default "global" — required for Gemini 3.x. Use a regional
# value (e.g. "us-central1") only when pinning to a 2.5-era model.
GCP_REGION=global

# ─── Gemini direct API key (fallback) ─────────────────────────────────────
# Used whenever GCP_SA_KEY/GCP_PROJECT_ID are absent, AND as an automatic
# retry backend when Vertex itself returns a quota error (RESOURCE_EXHAUSTED/
# 429) even with Vertex configured — Vertex and this AI Studio key are
# separate quota pools on Google's side, so this catches cases like
# gemini-3.1-flash-image's tight default Vertex quota. Set this even when
# Vertex is already configured to get that fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Google Cloud Speech-to-Text / Text-to-Speech (separate API key) ─────
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# ─── ElevenLabs TTS ──────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

