{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/gemini/key-check",       "destination": "https://jsqdhgdedizsuunemdhh.supabase.co/functions/v1/gemini-key-check" },
    { "source": "/api/gemini",                 "destination": "https://jsqdhgdedizsuunemdhh.supabase.co/functions/v1/gemini" },
    { "source": "/api/google/speech-to-text",  "destination": "https://jsqdhgdedizsuunemdhh.supabase.co/functions/v1/google-speech-to-text" },
    { "source": "/api/google/text-to-speech",  "destination": "https://jsqdhgdedizsuunemdhh.supabase.co/functions/v1/google-text-to-speech" },
    { "source": "/api/google/operations",      "destination": "https://jsqdhgdedizsuunemdhh.supabase.co/functions/v1/google-operations" },
    { "source": "/api/elevenlabs/tts",         "destination": "https://jsqdhgdedizsuunemdhh.supabase.co/functions/v1/elevenlabs-tts" },
    { "source": "/api/elevenlabs/voices",      "destination": "https://jsqdhgdedizsuunemdhh.supabase.co/functions/v1/elevenlabs-voices" },
    { "source": "/api/youtube/transcript",     "destination": "https://jsqdhgdedizsuunemdhh.supabase.co/functions/v1/youtube-transcript" },
    { "source": "/api/youtube/:path*",   "destination": "https://autovid-flask.onrender.com/api/youtube/:path*" },
    { "source": "/api/video/:path*",     "destination": "https://autovid-flask.onrender.com/api/video/:path*" },
    { "source": "/api/files/:path*",     "destination": "https://autovid-flask.onrender.com/api/files/:path*" },
    { "source": "/api/instagram/:path*", "destination": "https://autovid-flask.onrender.com/api/instagram/:path*" },
    { "source": "/api/cookies/:path*",   "destination": "https://autovid-flask.onrender.com/api/cookies/:path*" },
    { "source": "/api/reddit/:path*",    "destination": "https://autovid-flask.onrender.com/api/reddit/:path*" },
    { "source": "/api/shorts/:path*",    "destination": "https://autovid-flask.onrender.com/api/shorts/:path*" },
    { "source": "/api/health",           "destination": "https://autovid-flask.onrender.com/api/health" }
  ]
}
